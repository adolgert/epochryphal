{
  "name": "epochryphal",
  "version": "0.0.0",
  "private": true,
  "description": "A pi extension for supervised and unattended code-porting work.",
  "type": "module",
  "files": [
    "src",
    "template",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "bin": {
    "harness-report": "./src/bin/harness-report.ts",
    "harness-run": "./src/bin/harness-run.ts",
    "harness-ctl": "./src/bin/harness-ctl.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "tsc --noEmit && vitest run",
    "test:unit": "vitest run test/unit",
    "test:sdk": "vitest run test/sdk",
    "test:cli": "vitest run test/cli",
    "test:live": "vitest run test/live",
    "test:drift": "vitest run -t drift",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.1",
    "@earendil-works/pi-coding-agent": "1.5.1",
    "@types/node": "22.19.19",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
